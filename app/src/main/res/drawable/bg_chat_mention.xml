<?xml version="1.0" encoding="utf-8"?>
<!-- A chat message that @mentions the signed-in account: a faint green wash with a bar on the left. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2453FC18" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#53FC18" />
        </shape>
    </item>
</layer-list>
