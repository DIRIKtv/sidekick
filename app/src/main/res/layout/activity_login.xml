<?xml version="1.0" encoding="utf-8"?>
<!-- kick.com loads in webFrame behind the pairing screen: the phone's login is typed into it there.
     It only comes to the front if the viewer asks for it (☰), e.g. for a security check. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <FrameLayout
        android:id="@+id/webFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/pairPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="false"
        tools:ignore="KeyboardInaccessibleWidget"
        android:gravity="center"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingEnd="64dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_wordmark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-black"
                android:text="Sign in with your phone"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingMultiplier="1.5"
                android:text="1.  Connect your phone to the same Wi-Fi as this TV\n2.  Scan the code with your phone's camera\n3.  Type your Kick login on your phone"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/pairStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/kick_green"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/pairHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:lineSpacingMultiplier="1.25"
                android:text="BACK cancels  •  ☰ signs in on the TV with the remote instead"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Sidekick is an unofficial app, not affiliated with Kick. Your login is only sent to kick.com."
                android:alpha="0.7"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tooltip"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/qr"
                    android:contentDescription="QR code: scan it to sign in on your phone"
                    android:layout_width="240dp"
                    android:layout_height="240dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/pairUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
