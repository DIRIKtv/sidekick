<?xml version="1.0" encoding="utf-8"?>
<!-- The seek bar while it has focus: twice as thick, so it's clear the arrows now scrub. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#55FFFFFF"/><corners android:radius="5dp"/><size android:height="10dp"/></shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip><shape><solid android:color="#99FFFFFF"/><corners android:radius="5dp"/></shape></clip>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/kick_green"/><corners android:radius="5dp"/></shape></clip>
    </item>
</layer-list>
