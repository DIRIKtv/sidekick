<?xml version="1.0" encoding="utf-8"?>
<!-- The Watch pill: white at rest, green while the hero has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="160"
    android:exitFadeDuration="160">
    <item android:state_activated="true">
        <shape><solid android:color="@color/kick_green"/><corners android:radius="99dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="#F2FFFFFF"/><corners android:radius="99dp"/></shape>
    </item>
</selector>
