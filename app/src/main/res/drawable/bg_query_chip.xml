<?xml version="1.0" encoding="utf-8"?>
<!-- Recent searches: dark glass at rest, solid green with focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="110"
    android:exitFadeDuration="110">
    <item android:state_focused="true">
        <shape><solid android:color="@color/kick_green"/><corners android:radius="22dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="@color/glass"/><stroke android:width="1dp" android:color="@color/glass_edge"/><corners android:radius="22dp"/></shape>
    </item>
</selector>
