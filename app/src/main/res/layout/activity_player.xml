<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    tools:ignore="MergeRootFrame">

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            app:resize_mode="fit"
            app:show_buffering="never"
            app:shutter_background_color="@android:color/black"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <com.diriktv.sidekick.ui.SwirlingLoader
            android:id="@+id/buffering"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Where you are in a past broadcast, while the controls are hidden (Settings → Playback) -->
        <ProgressBar
            android:id="@+id/miniProgress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:progressDrawable="@drawable/seek_progress"
            android:visibility="gone" />

        <!-- Every message the player shows (seeking, quality, follows…) drops in here, top centre. -->
        <TextView
            android:id="@+id/osd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_toast"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="22dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="24dp"
            android:layout_marginTop="110dp"
            android:background="@drawable/bg_chip_dark"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Error: an icon, what happened in plain words, and what you can do about it -->
        <LinearLayout
            android:id="@+id/errorView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_player_card"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingTop="36dp"
            android:paddingEnd="48dp"
            android:paddingBottom="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/errorIcon"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_error_icon"
                android:importantForAccessibility="no"
                android:padding="20dp"
                android:tint="@color/kick_green" />

            <TextView
                android:id="@+id/errorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:maxWidth="560dp"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:maxWidth="520dp"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/retryButton"
                    style="@style/Pill"
                    android:drawableStart="@drawable/ic_refresh"
                    android:text="Retry" />

                <TextView
                    android:id="@+id/errorSecondary"
                    style="@style/Pill"
                    android:layout_marginEnd="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Controls overlay -->
        <FrameLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/scrim_top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="40dp"
                android:paddingTop="28dp"
                android:paddingEnd="40dp"
                android:paddingBottom="56dp">

                <!-- Who's on: avatar, title, and the channel line, in one card -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/headerCard"
                    tools:ignore="UselessParent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_player_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/avatar"
                    android:importantForAccessibility="no"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/streamTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:maxWidth="860dp"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/channelName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/kick_green"
                            android:textSize="14sp" />

                        <!-- Shown when you follow the channel -->
                        <ImageView
                            android:id="@+id/followedHeart"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="Following"
                            android:src="@drawable/ic_heart"
                            android:tint="@color/kick_green"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/streamMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="640dp"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp"
                            tools:ignore="RtlSymmetry" />
                    </LinearLayout>
                </LinearLayout>
                </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/scrim_bottom"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingTop="80dp"
                android:paddingEnd="40dp"
                android:paddingBottom="22dp">

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginStart="-12dp"
                    android:layout_marginEnd="-12dp"
                    android:background="@null"
                    android:focusable="true"
                    android:maxHeight="10dp"
                    android:minHeight="4dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:progressDrawable="@drawable/seek_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/durationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="6dp"
                    android:clipChildren="false">

                    <!-- Left: live status / jump to live, and the streamer's channel -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                    <!-- Live status / jump to live, with the viewer count (its digits roll when it changes). -->
                    <LinearLayout
                        android:id="@+id/btnLive"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_live_pill"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp">

                        <TextView
                            android:id="@+id/liveLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:textColor="@color/on_focus_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/liveSep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:layout_marginEnd="7dp"
                            android:duplicateParentState="true"
                            android:includeFontPadding="false"
                            android:text="·"
                            android:textColor="@color/on_focus_primary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.diriktv.sidekick.ui.RollingCounter
                            android:id="@+id/viewerCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageButton android:id="@+id/btnProfile" style="@style/CtrlButton" android:layout_marginStart="10dp" android:contentDescription="Go to channel" android:src="@drawable/ic_person" />
                    </LinearLayout>

                    <!-- Center: transport -->
                    <LinearLayout
                        android:id="@+id/transport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton android:id="@+id/btnRewind" style="@style/CtrlButton" android:contentDescription="Rewind" android:src="@drawable/ic_replay" />
                        <ImageButton android:id="@+id/btnPlay" style="@style/CtrlButton" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:padding="16dp" android:contentDescription="Play/Pause" android:src="@drawable/ic_pause" />
                        <ImageButton android:id="@+id/btnForward" style="@style/CtrlButton" android:contentDescription="Forward" android:src="@drawable/ic_forward" />
                    </LinearLayout>

                    <!-- Right: secondary actions -->
                    <LinearLayout
                        android:id="@+id/actions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <ImageButton android:id="@+id/btnCaptions" style="@style/CtrlButton" android:layout_marginStart="10dp" android:contentDescription="Captions" android:src="@drawable/ic_cc" android:visibility="gone" />
                        <TextView
                            android:id="@+id/btnQuality"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_ctrl_pill"
                            android:contentDescription="Quality"
                            android:drawableStart="@drawable/ic_hd"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/ctrl_icon"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="14dp"
                            android:paddingEnd="18dp"
                            android:textColor="@color/ctrl_icon"
                            android:textSize="14sp" />
                        <ImageButton android:id="@+id/btnChat" style="@style/CtrlButton" android:layout_marginStart="10dp" android:contentDescription="Chat" android:src="@drawable/ic_chat" />
                        <ImageButton android:id="@+id/btnPhone" style="@style/CtrlButton" android:layout_marginStart="10dp" android:contentDescription="Chat from your phone" android:src="@drawable/ic_phone" />
                        <ImageButton android:id="@+id/btnFollow" style="@style/CtrlButton" android:layout_marginStart="10dp" android:contentDescription="Follow" android:src="@drawable/ic_heart_outline" />
                        <ImageButton android:id="@+id/btnSettings" style="@style/CtrlButton" android:layout_marginStart="10dp" android:contentDescription="Settings" android:src="@drawable/ic_settings" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Label that floats above the focused button -->
            <TextView
                android:id="@+id/tooltip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tooltip"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="#000000"
                android:textSize="12sp"
                android:visibility="invisible" />

            <!-- Rides above the seek bar while you scrub: where you'd land, with a frame of it on past broadcasts -->
            <LinearLayout
                android:id="@+id/seekBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_player_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="invisible">

                <FrameLayout
                    android:id="@+id/seekPreview"
                    android:layout_width="256dp"
                    android:layout_height="144dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/seekTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Chat -->
    <LinearLayout
        android:id="@+id/chatPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/chat_bg"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chatHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="STREAM CHAT"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- The channel's pinned message -->
        <TextView
            android:id="@+id/chatPinned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_chat_card"
            android:drawableStart="@drawable/ic_pin"
            android:drawablePadding="8dp"
            android:drawableTint="@color/kick_green"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:textColor="#F2F2F2"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- A running poll or prediction -->
        <LinearLayout
            android:id="@+id/chatPoll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_chat_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:descendantFocusability="blocksDescendants"
            android:focusable="false"
            android:overScrollMode="never"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false" />
    </LinearLayout>

</FrameLayout>
