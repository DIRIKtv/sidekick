<?xml version="1.0" encoding="utf-8"?>
<!-- A hairline edge when focused; the lift and glow are done in code. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="160"
    android:exitFadeDuration="160">
    <item android:state_focused="true">
        <shape><stroke android:width="1.5dp" android:color="#8053FC18"/><corners android:radius="16dp"/></shape>
    </item>
    <item><color android:color="@android:color/transparent"/></item>
</selector>
