<?xml version="1.0" encoding="utf-8"?>
<!-- A thin edge when focused; the lift and glow are done in code. It's inset by half its width
     with a matching smaller radius, so its outer edge follows the hero's rounded clip exactly
     and no picture shows past it at the corners. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="160"
    android:exitFadeDuration="160">
    <item android:state_focused="true">
        <inset android:inset="1dp">
            <shape><stroke android:width="2dp" android:color="@color/kick_green"/><corners android:radius="15dp"/></shape>
        </inset>
    </item>
    <item><color android:color="@android:color/transparent"/></item>
</selector>
