<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="176dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="24dp"
        android:paddingEnd="38dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/navLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_wordmark" />

        <!-- One highlight glides behind the items (see NavIndicator). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.diriktv.sidekick.ui.NavIndicator
                android:id="@+id/navIndicator"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:id="@+id/navHome" style="@style/NavItem" android:background="@null" android:drawableStart="@drawable/ic_home" android:text="Home" />
                <TextView android:id="@+id/navFollowing" style="@style/NavItem" android:background="@null" android:drawableStart="@drawable/ic_heart" android:text="Following" />
                <TextView android:id="@+id/navBrowse" style="@style/NavItem" android:background="@null" android:drawableStart="@drawable/ic_grid" android:text="Browse" />
                <TextView android:id="@+id/navSearch" style="@style/NavItem" android:background="@null" android:drawableStart="@drawable/ic_search" android:text="Search" />
                <TextView android:id="@+id/navSettings" style="@style/NavItem" android:nextFocusDown="@+id/navAccount" android:background="@null" android:drawableStart="@drawable/ic_tune" android:text="Settings" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/navClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Who's signed in; select it to sign in, or for the account's options. -->
        <LinearLayout
            android:id="@+id/navAccount"
            android:nextFocusUp="@id/navSettings"
            android:nextFocusLeft="@id/navAccount"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_nav_item"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/navAvatar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="8dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/navName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/nav_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.diriktv.sidekick.ui.ContentFrame
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
